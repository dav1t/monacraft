MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Mindy
MC_VERSION=1.21.11

# openrouter, anthropic, openai (any OpenAI-compatible server) or ollama. The web panel can switch live.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# tools = native tool calling (qwen3, gpt-oss, llama3.1); json = structured output, works with any model (e.g. gemma3)
OLLAMA_MODE=tools
# true/false, or low/medium/high for gpt-oss. Thinking is smarter but much slower.
OLLAMA_THINK=false
# Context window in tokens (integer >= 2048). Ollama defaults to 4096, which truncates the prompt.
OLLAMA_NUM_CTX=8192

# OpenAI-compatible: OpenAI, OpenRouter, LM Studio (http://localhost:1234/v1), llama.cpp, Groq…
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=

OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_API_KEY=

ANTHROPIC_MODEL=claude-opus-5-5
# low, medium, high, xhigh or max
ANTHROPIC_EFFORT=high
ANTHROPIC_API_KEY=

DB_PATH=data/agent.db

# Web panel (pnpm panel)
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
